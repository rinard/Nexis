-- Reachable.gsl — GSL surface for structural reachability / unreachable-code elimination (§3 grammar,
-- explicit node form).  history · may ⇒ fwd·may.  Every node gens itself, nothing is killed, so the least
-- solution at n is the set of n's strict ancestors: non-empty iff n is reached from a predecessor.
include Tac.Locals

analysis Reachable {
  history Reachable reach : Defs[Node] {
    update : ∀ n→n'. genNode(n) ∪ (reach(n) ∩ transpAllNodes(n)) ⊆ reach(n')
    seed   : ∅ ⊆ reach(entry)
    within : ∀ n. reach(n) ⊆ allNodes
  }
}
